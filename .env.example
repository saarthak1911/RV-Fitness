# ==============================================================================
# RV Fitness Environment Configuration
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME="RV Fitness"
NEXT_PUBLIC_APP_SUBTITLE="NARSOBAWADI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (Local MongoDB by default)
# Windows local connection string per requirements Section 6:
MONGODB_URI="mongodb://127.0.0.1:27017/rvfitness"

# Authentication & Security
JWT_SECRET="rvfitness_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway (Test Mode defaults)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# Email Notifications (Nodemailer SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@rvfitness.local"
SMTP_PASS="placeholder_app_password"
SMTP_FROM="RV Fitness <no-reply@rvfitness.local>"

# Cloudinary Media Storage (Optional for production, local uploads supported)
CLOUDINARY_CLOUD_NAME="rvfitness_demo"
CLOUDINARY_API_KEY="placeholder_api_key"
CLOUDINARY_API_SECRET="placeholder_api_secret"

# Gym Contact Information (Defaults from Requirements)
NEXT_PUBLIC_GYM_LOCATION="Narsobawadi, Maharashtra, India"
NEXT_PUBLIC_GYM_PHONE="+91 98765 43210"
NEXT_PUBLIC_GYM_EMAIL="contact@rvfitness.com"
NEXT_PUBLIC_GYM_WHATSAPP="919876543210"
